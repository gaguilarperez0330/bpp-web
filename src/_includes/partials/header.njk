<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a class="logo" href="/" aria-label="{{ site.full_name }}, home">{% include "partials/monogram.njk" %}<span class="logo__name">Beatriz Perez<small>Photography</small></span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-toggle__label">Menu</span><span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
