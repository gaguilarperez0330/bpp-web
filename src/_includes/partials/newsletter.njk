{%- if not hideNewsletter %}
<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="wrap newsletter__inner">
    <div>
      <h2 id="newsletter-title" class="newsletter__title">{{ site.newsletter.title }}</h2>
      <p class="newsletter__text">{{ site.newsletter.text }}</p>
    </div>
    <form class="newsletter__form" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="company" action="/thank-you/">
      <input type="hidden" name="form-name" value="newsletter">
      <p class="visually-hidden"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off"></label></p>
      <label class="visually-hidden" for="newsletter-email">Email address</label>
      <input id="newsletter-email" type="email" name="email" placeholder="Your email address" required autocomplete="email">
      <button type="submit">Sign up</button>
    </form>
  </div>
</section>
{%- endif %}
