<div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Image viewer">
  <button class="lightbox__close" type="button" data-lb-close aria-label="Close">Close</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb-prev aria-label="Previous image">←</button>
  <figure class="lightbox__stage">
    <img alt="" data-lb-img>
    <figcaption data-lb-cap></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb-next aria-label="Next image">→</button>
  <p class="lightbox__hint">Click the image to zoom</p>
</div>
